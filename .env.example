# Copy to ".env" and adjust. ".env" is git-ignored and must never contain a real secret
# that is also used elsewhere. The values below are development placeholders only.
#
# This file feeds both docker compose (variable substitution in docker-compose.yml)
# and the application (spring.config.import in application.yml).

# --- Database -----------------------------------------------------------------
# DATABASE_URL must point at the same database/port docker-compose.yml exposes.
DATABASE_URL=jdbc:postgresql://localhost:5432/auth
DATABASE_USERNAME=auth
DATABASE_PASSWORD=auth

# Used by docker-compose.yml only.
POSTGRES_DB=auth
POSTGRES_PORT=5432

# --- JWT ----------------------------------------------------------------------
# Replace with a long random value, e.g. `openssl rand -base64 48`.
# There is no default: the application must not run on a committed signing key.
JWT_SECRET=replace-me-with-a-long-random-development-only-secret

# Durations, not milliseconds (Spring Duration format: 15m, 7d, 900s).
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# --- Demo accounts ------------------------------------------------------------
# Seeded by db/migration/V7__seed_demo_users.sql, which stores only the BCrypt hash.
# These plaintexts exist so the API can be tried locally; they are sample data, not secrets,
# and are not read by the application. (Hand-over README follows in backlog 0008.)
#   admin / admin12345   -> ROLE_ADMIN (ACCOUNT_READ, PASSWORD_CHANGE, USER_READ, USER_MANAGE)
#   user  / user12345    -> ROLE_USER  (ACCOUNT_READ, PASSWORD_CHANGE)
